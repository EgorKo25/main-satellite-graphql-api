# Example development settings; these are not production credentials.
POSTGRES_USER=graphql
POSTGRES_PASSWORD=graphql_dev
POSTGRES_DB=graphql
DB_PORT=5432
HTTP_PORT=8080
TEST_DB_PORT=5433

# Go processes launched on the host use these variables.
# Compose supplies its own DATABASE_URL using its db service name.
DATABASE_URL=postgres://graphql:graphql_dev@localhost:5432/graphql?sslmode=disable
TEST_DATABASE_URL=postgres://graphql_test:graphql_test@localhost:5433/postgres?sslmode=disable
CONFIG_PATH=config.yaml
MIGRATION_TIMEOUT=1m
